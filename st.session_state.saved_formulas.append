def sync_nutrient_schema_from_supabase():
    """ดึงข้อมูลโครงสร้างหัวข้อสารอาหาร (Nutrient Schema) จากคลาวด์"""
    try:
        response = supabase.table("nutrient_schema").select("*").execute()
        if response.data and len(response.data) > 0:
            schema_dict = {}
            for item in response.data:
                schema_dict[item["key_name"]] = {
                    "label": item.get("label", item["key_name"]),
                    "step": float(item.get("step", 0.1)),
                    "default": float(item.get("default_val", 0.0))
                }
            st.session_state.db_nutrient_keys = schema_dict
    except Exception as e:
        # Fallback ในกรณีที่ตาราง Schema ยังไม่พร้อมใช้งานบนคลาวด์
        if "db_nutrient_keys" not in st.session_state:
            st.session_state.db_nutrient_keys = {
                "price": {"label": "ราคากลาง (บาท/กก.)", "step": 0.1, "default": 0.0},
                "protein": {"label": "โปรตีนดิบ (% CP)", "step": 0.1, "default": 0.0},
                "me": {"label": "พลังงานใช้ประโยชน์ได้ (ME kcal/kg)", "step": 10.0, "default": 0.0},
                "calcium": {"label": "แคลเซียม (% Ca)", "step": 0.01, "default": 0.0},
                "phos": {"label": "ฟอสฟอรัสเป็นประโยชน์ (% Avail. P)", "step": 0.01, "default": 0.0},
                "lysine": {"label": "อะมิโน ไลซีน (% Lys)", "step": 0.01, "default": 0.0},
                "methionine": {"label": "อะมิโน เมทไธโอนีน (% Met)", "step": 0.01, "default": 0.0},
                "fiber": {"label": "เยื่อใย (% Fiber)", "step": 0.1, "default": 0.0}
            }

def sync_master_data_from_supabase():
    """ดึงข้อมูลกลุ่มสายพันธุ์, สายพันธุ์ย่อย และเกณฑ์อาหารเป้าหมาย"""
    try:
        # 1. โหลดกลุ่มสายพันธุ์หลัก
        res_groups = supabase.table("db_groups").select("*").execute()
        if res_groups.data:
            st.session_state.db_groups = res_groups.data
            
        # 2. โหลดสายพันธุ์ย่อย
        res_breeds = supabase.table("db_breeds").select("*").execute()
        if res_breeds.data:
            st.session_state.db_breeds = res_breeds.data
            
        # 3. โหลดเกณฑ์ความต้องการสารอาหารเป้าหมาย
        res_targets = supabase.table("db_targets").select("*").execute()
        if res_targets.data:
            target_dict = {}
            for target in res_targets.data:
                target_dict[target["stage_key"]] = target
            st.session_state.db_targets = target_dict
            
    except Exception as e:
        st.error(f"❌ ไม่สามารถโหลด Master Data จาก Supabase ได้: {e}")

def sync_ingredients_from_supabase():
    """ดึงข้อมูลคลังวัตถุดิบหลักแบบเรียลไทม์"""
    try:
        response = supabase.table("db_ingredients").select("*").execute()
        if response.data:
            ingredients_dict = {}
            for item in response.data:
                ingredients_dict[item["name"]] = item
            st.session_state.db_ingredients = ingredients_dict
            return ingredients_dict
        else:
            st.session_state.db_ingredients = {}
            return {}
    except Exception as e:
        st.error(f"⚠️ ไม่สามารถซิงค์ข้อมูลคลังวัตถุดิบได้: {e}")
        if "db_ingredients" not in st.session_state:
            st.session_state.db_ingredients = {}
        return st.session_state.db_ingredients

def load_user_private_data_from_supabase(user_email):
    """โหลดข้อมูลส่วนตัวสูตรอาหารและ Log เฉพาะรายฟาร์มของยูสเซอร์ที่ล็อกอิน"""
    try:
        # โหลดสูตรอาหารที่บันทึก
        res_formulas = supabase.table("saved_formulas").select("*").eq("user_owner", user_email).execute()
        st.session_state.saved_formulas = res_formulas.data if res_formulas.data else []
        
        # โหลดบันทึกการจัดการประจำวัน
        res_logs = supabase.table("daily_logs").select("*").eq("user_owner", user_email).execute()
        st.session_state.daily_logs = res_logs.data if res_logs.data else []
        
    except Exception as e:
        st.sidebar.error(f"⚠️ โหลดข้อมูลประวัติผู้ใช้ล้มเหลว: {e}")

# --- สั่งทำงานฟังก์ชันโหลดข้อมูลโครงสร้างหลักทันทีที่เปิดแอปพลิเคชัน ---
sync_nutrient_schema_from_supabase()
sync_master_data_from_supabase()
sync_ingredients_from_supabase()

# --- ตรวจสอบสิทธิ์ผู้ใช้งานเพื่อโหลดข้อมูลส่วนตัว (สลับแทนที่ระบบจำลองข้อมูลเก่า) ---
if st.session_state.get("is_authenticated", False) and st.session_state.get("current_user_key"):
    load_user_private_data_from_supabase(st.session_state.current_user_key)

# ==========================================
# 🧮 3. CORE AI SOLVER ENGINE
# ==========================================
def run_ai_solver(req_p, req_m, req_c, req_ph, req_ly, req_me):
    prob = pulp.LpProblem("AI_First_Solver", pulp.LpMinimize)
    
    # แก้ไขจุดนี้: เรียกใช้ฟังก์ชันซิงค์ข้อมูลที่ถูกต้องและดึงสเตตล่าสุดมาคำนวณ
    current_ingredients = sync_ingredients_from_supabase()
    if not current_ingredients:
        st.error("❌ ไม่พบข้อมูลวัตถุดิบในระบบ ไม่สามารถคำนวณได้")
        return {}

    ing_vars = {name: pulp.LpVariable(name, lowBound=float(d["min_limit"])/100.0, upBound=float(d["max_limit"])/100.0) for name, d in current_ingredients.items()}
    
    s_p = pulp.LpVariable("s_p", lowBound=0)
    s_m = pulp.LpVariable("s_m", lowBound=0)
    s_c = pulp.LpVariable("s_c", lowBound=0)
    
    prob += pulp.lpSum([ing_vars[name] * float(d["price"]) for name, d in current_ingredients.items()]) + 1000.0 * (s_p + s_m/100.0 + s_c), "Cost"
    prob += pulp.lpSum([ing_vars[name] for name in current_ingredients.keys()]) == 1.0, "Weight"
    
    prob += pulp.lpSum([ing_vars[name] * float(d["protein"]) for name, d in current_ingredients.items()]) + s_p >= req_p
    prob += pulp.lpSum([ing_vars[name] * float(d["me"]) for name, d in current_ingredients.items()]) + s_m >= req_m
    prob += pulp.lpSum([ing_vars[name] * float(d["calcium"]) for name, d in current_ingredients.items()]) + s_c >= req_c
    prob += pulp.lpSum([ing_vars[name] * float(d["phos"]) for name, d in current_ingredients.items()]) >= req_ph
    prob += pulp.lpSum([ing_vars[name] * float(d["lysine"]) for name, d in current_ingredients.items()]) >= req_ly
    prob += pulp.lpSum([ing_vars[name] * float(d["methionine"]) for name, d in current_ingredients.items()]) >= req_me
    
    prob.solve(pulp.PULP_CBC_CMD(msg=False))
    
    res = {}
    for name in current_ingredients.keys():
        res[name] = round((ing_vars[name].varValue if ing_vars[name].varValue is not None else 0.0) * 100.0, 1)
    return res

