def check_password_strength(password):
    """ฟังก์ชันตรวจสอบความแข็งแกร่งของรหัสผ่าน"""
    if len(password) < 6:
        return False, "❌ รหัสผ่านต้องมีความยาวอย่างน้อย 6 ตัวอักษร"
    return True, "🟢 รหัสผ่านมีความปลอดภัยสูงตามมาตรฐาน"

